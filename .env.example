# Copy to .env and adjust as needed. All of these have sane defaults
# (see outage_notifier/settings/base.py) — you only need this file to
# override something.

DJANGO_SECRET_KEY=change-me-before-any-real-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# SQLite now; swap to a Postgres-backed DATABASES dict later (see plan
# doc's "DB agnostic" decision) without touching any other code.
SQLITE_PATH=db.sqlite3

RAW_DUMP_DIRECTORY=.dumps

HTTP_FETCH_TIMEOUT_SECONDS=15
HTTP_FETCH_USER_AGENT=Mozilla/5.0 (compatible; outage-notifier-bot/0.1; +local)

VEOLIA_TELEGRAM_CHANNEL=VeoliaJur

# Per-provider polling cadence for the v1 in-process scheduler (minutes).
ENA_FETCH_INTERVAL_MINUTES=60
VEOLIA_WEB_FETCH_INTERVAL_MINUTES=60
VEOLIA_TELEGRAM_FETCH_INTERVAL_MINUTES=15

ENA_FETCH_ENABLED=true
VEOLIA_WEB_FETCH_ENABLED=false
VEOLIA_TELEGRAM_FETCH_ENABLED=true

LOG_LEVEL=INFO
